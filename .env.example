# Copy this file to `.env` and fill in the values for your environment.
# All VITE_* variables are exposed to the browser — NEVER put secrets here.
# Developer-specific overrides go in `.env.local` (git-ignored).
# On Vercel, set these in Project Settings → Environment Variables (they override .env).

# Backend API base URL
VITE_API_BASE_URL=https://hfn-backend-production.up.railway.app/api

# Google reCAPTCHA v3 (site key — public by design)
VITE_RECAPTCHA_SITE_KEY=

# Google Analytics 4 measurement ID
VITE_GTAG_ID=

# Document title / brand name
VITE_APP_TITLE=Health Federation Of Nigeria
